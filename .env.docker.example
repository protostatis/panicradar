# Docker Deployment Environment Variables
# Copy to .env and fill in your values

# ============================================
# Required: Reddit API Credentials
# ============================================
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=crypto_sentiment_crawler/1.0

# ============================================
# Optional: External API Keys
# ============================================
# Whale Alert (for large transaction monitoring)
WHALE_ALERT_API_KEY=

# Etherscan (for on-chain data)
ETHERSCAN_API_KEY=

# ============================================
# WireGuard VPN (for Reddit access from cloud IPs)
# ============================================
# Reddit blocks AWS/cloud IPs. WireGuard VPN on the host routes
# traffic through a clean IP. Run deploy/setup-wireguard.sh to configure.
#
WG_PRIVATE_KEY=your_wireguard_private_key
WG_ADDRESS=10.x.x.x/32
WG_DNS=10.64.0.1
WG_PEER_PUBKEY=server_public_key
WG_ENDPOINT=server_ip:51820

# ============================================
# Proxy Configuration (optional, not needed with VPN)
# ============================================
# Only set if you prefer a proxy over WireGuard VPN.
PROXY_URL=

# ============================================
# Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tracked coins (comma-separated)
TRACKED_COINS=BTC,ETH,SOL

# ============================================
# Intervals (seconds) - Optional overrides
# ============================================
# PRICE_INTERVAL=300
# REDDIT_INTERVAL=600
# ONCHAIN_INTERVAL=120
# FEAR_GREED_INTERVAL=14400
