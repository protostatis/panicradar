# Docker Deployment Environment Variables
# Copy to .env and fill in your values

# ============================================
# Required: Reddit API Credentials
# ============================================
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=crypto_sentiment_crawler/1.0

# ============================================
# Optional: External API Keys
# ============================================
# Whale Alert (for large transaction monitoring)
WHALE_ALERT_API_KEY=

# Etherscan (for on-chain data)
ETHERSCAN_API_KEY=

# ============================================
# Proxy Configuration (for Reddit access from cloud IPs)
# ============================================
# Reddit blocks AWS/cloud IPs. Use a proxy to bypass.
# Supports HTTP, HTTPS, SOCKS5 proxies.
# Multiple proxies can be comma-separated for rotation.
#
# Examples:
#   PROXY_URL=http://user:pass@proxy.example.com:8080
#   PROXY_URL=socks5://user:pass@proxy.example.com:1080
#   PROXY_URL=http://proxy1:8080,http://proxy2:8080
#
# Free proxy services (less reliable):
#   - https://www.webshare.io/ (10 free proxies)
#   - https://proxyscrape.com/free-proxy-list
#
# Paid residential proxies (more reliable):
#   - https://brightdata.com/
#   - https://smartproxy.com/
#   - https://oxylabs.io/
#
PROXY_URL=

# ============================================
# Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tracked coins (comma-separated)
TRACKED_COINS=BTC,ETH,SOL

# ============================================
# Intervals (seconds) - Optional overrides
# ============================================
# PRICE_INTERVAL=300
# REDDIT_INTERVAL=600
# ONCHAIN_INTERVAL=120
# FEAR_GREED_INTERVAL=14400
