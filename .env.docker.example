# Docker Deployment Environment Variables
# Copy to .env and fill in your values

# ============================================
# Required: Reddit API Credentials
# ============================================
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=crypto_sentiment_crawler/1.0

# ============================================
# Optional: External API Keys
# ============================================
# Whale Alert (for large transaction monitoring)
WHALE_ALERT_API_KEY=

# Etherscan (for on-chain data)
ETHERSCAN_API_KEY=

# ============================================
# Reddit Unbrowser Cookie Transport
# ============================================
# Production hosts use direct EC2 egress; do not configure a host-wide VPN.
# The release workflow sets REDDIT_FETCH_MODE and the Unix socket itself.
# Set this token only after configuring the local solver; never commit it.
UNBROWSER_COOKIE_SERVICE_TOKEN=

# ============================================
# Proxy Configuration (optional fallback transport)
# ============================================
PROXY_URL=

# ============================================
# Telegram Bot (for signal alerts)
# ============================================
# Create via @BotFather on Telegram. Set as GitHub secret for CI/CD.
TELEGRAM_BOT_TOKEN=

# ============================================
# Signal Detection (auto-alerts to Telegram channel)
# ============================================
# Check interval in minutes (default: 30)
SIGNAL_CHECK_INTERVAL=30

# Telegram channel for auto-alerts (default: @PanicRadarAlerts)
# Bot must be admin of this channel with "Post Messages" permission
TELEGRAM_CHANNEL_ID=@PanicRadarAlerts

# ============================================
# Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tracked coins (comma-separated)
TRACKED_COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,DOT,LINK

# ============================================
# Intervals (seconds) - Optional overrides
# ============================================
# PRICE_INTERVAL=300
# REDDIT_INTERVAL=600
# ONCHAIN_INTERVAL=120
# FEAR_GREED_INTERVAL=14400

# ============================================
# Embedding Backend (sentiment scoring)
# ============================================
# EMBEDDING_BACKEND=local          → local sentence-transformers (default, safe)
# EMBEDDING_BACKEND=openrouter     → OpenRouter API (needs key below; fail-closed)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenRouter API key (https://openrouter.ai/keys)
# Only needed when EMBEDDING_BACKEND=openrouter.
OPENROUTER_API_KEY=
