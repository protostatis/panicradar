# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=crypto_sentiment_crawler/1.0

# Whale Alert (https://whale-alert.io/)
WHALE_ALERT_API_KEY=your_api_key

# Etherscan (https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_api_key

# Database
DATABASE_PATH=data/sentiment.db

# Coins to track (comma-separated)
TRACKED_COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,DOT,LINK

# Collector intervals (seconds)
PRICE_INTERVAL=300
REDDIT_INTERVAL=600
ONCHAIN_INTERVAL=120
FEAR_GREED_INTERVAL=14400

# Logging
LOG_LEVEL=INFO

# OpenRouter API (https://openrouter.ai/keys) — used only when
# EMBEDDING_BACKEND=openrouter (opt-in, NOT the default).
OPENROUTER_API_KEY=

# Embedding backend for sentiment scoring.
#   EMBEDDING_BACKEND=local         → sentence-transformers (default, no API key)
#   EMBEDDING_BACKEND=openrouter    → OpenRouter /embeddings (requires key above)
# OpenRouter selection is fail-closed; the crawler never falls back to a local
# model because mixing embedding spaces changes sentiment scores.
EMBEDDING_BACKEND=local
# Local: all-MiniLM-L6-v2 | all-mpnet-base-v2 | BAAI/bge-m3 ...
# OpenRouter (opt-in): qwen/qwen3-embedding-8b | openai/text-embedding-3-large ...
EMBEDDING_MODEL=all-MiniLM-L6-v2
